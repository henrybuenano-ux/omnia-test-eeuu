 <script type="text/javascript">
 	 jQuery(document).ready(function(){
     jQuery("#form_contact_us").submit(function(e){
     e.preventDefault();
     jQuery("#enviarForm").html("<i class='fa fa-spinner'></i>");
     var form_validar = jQuery("#form_contact_us");
     var validar = checkCampos(form_validar);
     var dataString = form_validar.serialize();
     if(validar){
     ///
      jQuery.ajax({
        url: "<?php echo $this->baseurl ?>/templates/<?php echo $this->template ?>/respuestacontacto.php",
        type: "POST",
        data: dataString,
        dataType: "html",
        success: function(data){
         jQuery("#enviarForm").html("Submit");
         jQuery("#refresh").html(data);

        }
    });
     ///
     } else {
       jQuery("#refresh").html("<span style='color:red'>Debes llenar todos los campos</span>");
       jQuery("#enviarForm").html("Submit");
     }
     });
 	 });

 	 function checkCampos(obj){
 	 	var camposRellenados = true;
 	 	obj.find("input").each(function(){
             var $this = jQuery(this);
             if($this.val().length <= 0){
             	camposRellenados = false;
             	return false;
             }
 	 	});
 	 	if(camposRellenados == false){
 	 		return false;
 	 	} else {
 	 		return true;
 	 	}
 	 }
 </script>

