<?php

class Flooring {

    public function D( $idarticulo ) {
        $db = new Query;
        $consulta = "SELECT title, images, introtext FROM riuhb_content WHERE id=:id LIMIT 1";
        $Query = $db->link->prepare($consulta);
        $Query->bindParam(":id", $idarticulo);
        $Query->execute();
        $registros = $Query->fetchAll();
        $conn = count($registros);

        if ( $conn ):
            $Query->execute();
            $Query->setFetchMode(PDO::FETCH_ASSOC);
            return $Query;
        else:
            return false;
        endif;
    }
}

$ofw1 = new Flooring();
$ofw2 = $ofw1->D(7);

foreach ( $ofw2 as $info ):
    $ds = json_decode($info["images"]);
    $imagenSeccion = $ds->image_intro;
?>

